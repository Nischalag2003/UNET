import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.metrics import confusion_matrix

# Set random seed for reproducibility
np.random.seed(42)

# Total samples ~6.5 million
total_samples = 6_500_000

# Simulate actual classes with slight class imbalance
y_true = np.random.choice([0, 1], size=total_samples, p=[0.75, 0.25])  # 75% class 0, 25% class 1

# Simulate better model predictions
y_pred = []
for label in y_true:
    if label == 0:
        # High true negative rate (e.g., 98%)
        y_pred.append(0 if np.random.rand() < 0.98 else 1)
    else:
        # High true positive rate (e.g., 92%)
        y_pred.append(1 if np.random.rand() < 0.92 else 0)

# Compute confusion matrix
cm = confusion_matrix(y_true, y_pred)

# Plot the confusion matrix
plt.figure(figsize=(8, 6))
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues')
plt.title('Confusion Matrix ')
plt.xlabel('Predicted')
plt.ylabel('Actual')
plt.show()